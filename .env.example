# =============================================================================
# SaaS Marmitarias iFood — variáveis de ambiente (template)
# Copie para .env (local) ou configure no painel da Vercel.
# NUNCA commitar .env. NUNCA prefixar secrets com NEXT_PUBLIC_.
#
# Como preencher para o projeto Supabase real:
#   1. No painel do Supabase (Authentication → Providers → Email) ative
#      "Confirm email" conforme a política desejada.
#   2. Em Authentication → URL Configuration adicione:
#        Site URL:           $NEXT_PUBLIC_APP_URL
#        Redirect URLs:      $NEXT_PUBLIC_APP_URL/auth/callback
#   3. Em Settings → API copie:
#        Project URL       → NEXT_PUBLIC_SUPABASE_URL
#        anon public key   → NEXT_PUBLIC_SUPABASE_ANON_KEY
#        service_role key  → SUPABASE_SERVICE_ROLE_KEY   (NUNCA expor no browser)
#   4. Em Settings → Database copie:
#        Connection string (pooled, 6543) → DATABASE_URL
#        Connection string (direct, 5432) → DIRECT_URL
#      Troque a senha na string pelo valor real que você definiu.
# =============================================================================

# ---------- Aplicação ----------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ambiente de integração iFood: 'sandbox' | 'production'
IFOOD_ENVIRONMENT=sandbox

# Chave mestra (AES-256-GCM) para criptografar client_secret / tokens do iFood
# em repouso no banco. Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=

# Email do primeiro SUPER_ADMIN. Ao rodar o seed, esse usuário é criado/promovido.
INITIAL_SUPER_ADMIN_EMAIL= joao@deliveryreal.com

# ---------- Supabase ----------
# URL e chave anônima são públicas (NEXT_PUBLIC) — usadas pelo client browser.
# No Supabase atual (>= 2.x), a "anon public key" e a "publishable key" referem-se
# à mesma chave (role: anon). Mantemos a nomenclatura NEXT_PUBLIC_SUPABASE_ANON_KEY
# para preservar a arquitetura existente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — SERVER ONLY, jamais NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# Conexão do app (Prisma) — pooled via Supavisor (porta 6543)
DATABASE_URL=

# Conexão direta — usada pelas migrations (Prisma Migrate / db push) — porta 5432
DIRECT_URL=

# ---------- iFood (sandbox) ----------
# Credenciais geradas em https://developer.ifood.com.br para o app de SANDBOX
IFOOD_SANDBOX_CLIENT_ID=
IFOOD_SANDBOX_CLIENT_SECRET=

# ---------- iFood (produção) ----------
# Credenciais geradas em https://developer.ifood.com.br para o app de PRODUÇÃO
# Preencher apenas quando for promover. Não usar em dev.
IFOOD_PRODUCTION_CLIENT_ID=
IFOOD_PRODUCTION_CLIENT_SECRET=
