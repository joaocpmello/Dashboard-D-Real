# =============================================================================
# SaaS Marmitarias iFood — variáveis de ambiente (template)
# Copie para .env (local) ou configure no painel da Vercel.
# NUNCA commitar .env. NUNCA prefixar secrets com NEXT_PUBLIC_.
# =============================================================================

# ---------- Aplicação ----------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ambiente de integração iFood: 'sandbox' | 'production'
IFOOD_ENVIRONMENT=sandbox

# Chave mestra (AES-256-GCM) para criptografar client_secret / tokens do iFood
# em repouso no banco. Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=

# Email do primeiro SUPER_ADMIN. Ao rodar o seed, esse usuário é criado/promovido.
INITIAL_SUPER_ADMIN_EMAIL=

# ---------- Supabase ----------
# URL e chave anônima são públicas (NEXT_PUBLIC) — usadas pelo client browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — SERVER ONLY, jamais NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# Conexão do app (Prisma) — pooled via Supavisor
DATABASE_URL=

# Conexão direta — usada pelas migrations (Prisma Migrate / db push)
DIRECT_URL=

# ---------- iFood (sandbox) ----------
# Credenciais geradas em https://developer.ifood.com.br para o app de SANDBOX
IFOOD_SANDBOX_CLIENT_ID=
IFOOD_SANDBOX_CLIENT_SECRET=

# ---------- iFood (produção) ----------
# Credenciais geradas em https://developer.ifood.com.br para o app de PRODUÇÃO
# Preencher apenas quando for promover. Não usar em dev.
IFOOD_PRODUCTION_CLIENT_ID=
IFOOD_PRODUCTION_CLIENT_SECRET=
