// =====================================================================
// iFood Integration - Fresh Start
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IfoodConfig {
  id                    String   @id @default(cuid())
  clientId              String
  clientSecret          String
  accessTokenCipher     String?
  accessTokenExpiresAt  DateTime?
  accessTokenKeyVersion Int?     @default(1)
  clientSecretKeyVersion Int?     @default(1)
  refreshToken          String?
  merchantId            String   @unique
  environment           String   @default("production")
  ativo                 Boolean  @default(true)
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  categories            IfoodCategory[]
  products              IfoodProduct[]

  @@map("ifood_credentials")
}

model IfoodCategory {
  id        String   @id
  name      String
  configId  String
  config    IfoodConfig @relation(fields: [configId], references: [id])
  products  IfoodProduct[]

  @@map("ifood_categories")
}

model IfoodProduct {
  id          String   @id
  name        String
  description String?
  price       Float
  categoryId  String
  category    IfoodCategory @relation(fields: [categoryId], references: [id])
  configId    String
  config      IfoodConfig @relation(fields: [configId], references: [id])
  updatedAt   DateTime @updatedAt

  @@map("ifood_products")
}
