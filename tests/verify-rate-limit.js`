const fetch = require('node-fetch');

async function testRateLimit() {
  const TARGET_URL = 'http://localhost:3000/api/merchants/sync';
  const AUTH_COOKIE = 'supabase-auth-token=YOUR_SESSION_TOKEN_HERE'; // Replace with actual token from browser cookies

  console.log(`🚀 Starting Rate Limit test for ${TARGET_URL}...`);

  for (let i = 1; i <= 12; i++) {
    try {
      const response = await fetch(TARGET_URL, {
        method: 'POST',
        headers: { 'Cookie': AUTH_COOKIE },
      });

      if (response.status === 429) {
        console.log(`✅ Request ${i}: Received 429 Too Many Requests (Expected)`);
        console.log(`Retry-After header: ${response.headers.get('retry-after')}`);
        return;
      } else {
        console.log(`Request ${i}: Status ${response.status} ${response.statusText}`);
      }
    } catch (error) {
      console.error(`❌ Request ${i} failed:`, error.message);
    }
  }

  console.log('❌ Test failed: Did not receive 429 after 11 requests.');
}

testRateLimit();
